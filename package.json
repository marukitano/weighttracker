{
  "name": "weighttracker-pebble-time-2",
  "version": "0.1.2",
  "description": "WeightTracker for Pebble watches, including Pebble Time 2",
  "author": "Viktor Csala; Pebble Time 2 adaptation by marukitano",
  "license": "GPL-3.0-or-later",
  "private": true,
  "keywords": [
    "pebble-app",
    "weight-tracker"
  ],
  "dependencies": {
    "@rebble/clay": "^1.0.8"
  },
  "pebble": {
    "displayName": "WeightTracker",
    "uuid": "7841b128-43c1-4f14-8303-89faf5e0a1a4",
    "sdkVersion": "3",
    "targetPlatforms": [
      "emery"
    ],
    "enableMultiJS": true,
    "watchapp": {
      "watchface": false
    },
    "messageKeys": {
      "PIN_DATE": 1,
      "PIN_TIME": 2,
      "PIN_ID": 3,
      "PIN_COMMAND": 4,
      "PIN_TYPE": 5,
      "PIN_WEIGHT": 6,
      "HEIGHT_CM": 60,
      "CHART_COLOR": 61,
      "CHART_MODE": 62,
      "CHART_RANGE": 63,
      "UNIT": 64,
      "LABEL_ABOVE": 65,
      "LABEL_BELOW": 66
    },
    "resources": {
      "media": [
        {
          "file": "images/action_bar_icon_up.png",
          "name": "ACTION_BAR_UP",
          "type": "bitmap"
        },
        {
          "file": "images/action_bar_icon_down.png",
          "name": "ACTION_BAR_DOWN",
          "type": "bitmap"
        },
        {
          "file": "images/action_bar_icon_check.png",
          "name": "ACTION_BAR_CHECK",
          "type": "bitmap"
        }
      ]
    },
    "capabilities": [
      "configurable"
    ]
  }
}
