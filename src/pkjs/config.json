  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Export measurements"
      },
      {
        "type": "text",
        "defaultValue": "<p>Export all stored readings as Excel-compatible CSV (date and weight in kg).</p><button type=\"button\" id=\"wt-export-download\" style=\"padding:12px 20px;\">Download CSV</button><button type=\"button\" id=\"wt-export-copy\" style=\"margin-left:8px;padding:12px;\">Show / copy CSV</button><pre id=\"wt-export-status\" style=\"white-space:pre-wrap;word-break:break-word;max-height:130px;overflow:auto;\"></pre><textarea id=\"wt-export-csv\" style=\"display:none;width:100%;height:160px;\"></textarea>"
