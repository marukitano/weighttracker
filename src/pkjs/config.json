[
  {
    "type": "heading",
    "defaultValue": "WeightTracker"
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Units and BMI"
      },
      {
        "type": "select",
        "messageKey": "UNIT",
        "label": "Weight unit",
        "defaultValue": "0",
        "options": [
          {
            "label": "Kilograms (kg)",
            "value": "0"
          },
          {
            "label": "Pounds (lb)",
            "value": "2"
          },
          {
            "label": "Stone (st)",
            "value": "1"
          }
        ]
      },
      {
        "type": "slider",
        "messageKey": "HEIGHT_CM",
        "label": "Height (cm)",
        "description": "Enter your height to display BMI beside chart points. BMI is a screening indicator, not a diagnosis.",
        "defaultValue": 0,
        "min": 0,
        "max": 230,
        "step": 1
      }
    ]
  },
  {
    "type": "section",
    "items": [
      {
        "type": "heading",
        "defaultValue": "Chart"
