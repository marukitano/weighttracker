          }
        ]
      },
      {
        "type": "select",
        "messageKey": "LABEL_BELOW",
        "label": "Below measurement point",
        "defaultValue": "0",
        "options": [
          {
            "label": "Date",
            "value": "0"
          },
          {
            "label": "Weight",
            "value": "1"
          },
          {
            "label": "BMI",
